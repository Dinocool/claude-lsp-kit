{
	"name": "lsp-kit",
	"description": "Svelte, TypeScript/JavaScript, Rust and Lua language servers for Claude Code's LSP tool, behind one machine-wide manager: native file watching instead of the servers' whole-tree fallbacks, one Rust, TypeScript and Svelte server for every checkout, one Lua server per git worktree, all shared by every session, nested Cargo crates linked; hooks advertise the LSP and steer symbol work to it.",
	"version": "3.6.0",
	"author": { "name": "Dinocool", "url": "https://github.com/Dinocool" },
	"repository": "https://github.com/Dinocool/claude-lsp-kit",
	"license": "MIT",
	"keywords": ["lsp", "svelte", "sveltekit", "typescript", "javascript", "rust", "rust-analyzer", "lua", "lua-language-server", "worktree"],
	"lspServers": {
		"svelte": {
			"command": "node",
			"args": ["${CLAUDE_PLUGIN_ROOT}/proxy.mjs", "svelte"],
			"extensionToLanguage": { ".svelte": "svelte" }
		},
		"typescript": {
			"command": "node",
			"args": ["${CLAUDE_PLUGIN_ROOT}/proxy.mjs", "typescript"],
			"extensionToLanguage": {
				".ts": "typescript",
				".mts": "typescript",
				".cts": "typescript",
				".tsx": "typescriptreact",
				".js": "javascript",
				".mjs": "javascript",
				".cjs": "javascript",
				".jsx": "javascriptreact"
			}
		},
		"rust-analyzer": {
			"command": "node",
			"args": ["${CLAUDE_PLUGIN_ROOT}/proxy.mjs", "rust"],
			"extensionToLanguage": { ".rs": "rust" }
		},
		"lua": {
			"command": "node",
			"args": ["${CLAUDE_PLUGIN_ROOT}/proxy.mjs", "lua"],
			"extensionToLanguage": { ".lua": "lua" }
		}
	}
}
