{
	"name": "lsp-kit",
	"description": "Svelte, Rust and Lua language servers for Claude Code's LSP tool, behind one proxy: native file watching instead of the servers' whole-tree fallbacks, a bounded server per git worktree, nested Cargo crates linked; hooks advertise the LSP and steer symbol work to it.",
	"version": "2.1.0",
	"author": { "name": "Dinocool", "url": "https://github.com/Dinocool" },
	"repository": "https://github.com/Dinocool/claude-lsp-kit",
	"license": "MIT",
	"keywords": ["lsp", "svelte", "sveltekit", "rust", "rust-analyzer", "lua", "lua-language-server", "worktree"],
	"lspServers": {
		"svelte": {
			"command": "node",
			"args": ["${CLAUDE_PLUGIN_ROOT}/proxy.mjs", "svelte"],
			"extensionToLanguage": { ".svelte": "svelte" }
		},
		"rust-analyzer": {
			"command": "node",
			"args": ["${CLAUDE_PLUGIN_ROOT}/proxy.mjs", "rust"],
			"extensionToLanguage": { ".rs": "rust" }
		},
		"lua": {
			"command": "node",
			"args": ["${CLAUDE_PLUGIN_ROOT}/proxy.mjs", "lua"],
			"extensionToLanguage": { ".lua": "lua" }
		}
	}
}
